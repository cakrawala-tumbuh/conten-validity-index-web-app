# ============================================================
# Environment Variables — Content Validity Index Web App
# ============================================================
# Salin file ini ke `.env.local` dan isi dengan nilai yang sesuai.
# JANGAN PERNAH commit file `.env.local` ke repository!
# ============================================================

# ----------------------------------------------------------
# NextAuth.js — WAJIB diisi
# ----------------------------------------------------------

# Secret acak min. 32 karakter untuk signing JWT NextAuth
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# URL publik aplikasi (tanpa trailing slash)
NEXTAUTH_URL=http://localhost:3000

# ----------------------------------------------------------
# Authentik OIDC Provider
# ----------------------------------------------------------

# URL issuer Authentik (WITH trailing slash)
# Format: http(s)://<authentik-host>/application/o/<app-slug>/
AUTHENTIK_ISSUER_URL=http://localhost:9000/application/o/cvi/

# Client ID dari Authentik OAuth2 Provider
AUTHENTIK_CLIENT_ID=your-authentik-client-id

# Client Secret dari Authentik OAuth2 Provider
AUTHENTIK_CLIENT_SECRET=your-authentik-client-secret

# Nama group Authentik untuk role admin (default: cvi-admin)
AUTHENTIK_ADMIN_GROUP=cvi-admin

# Nama group Authentik untuk role expert (default: cvi-expert)
AUTHENTIK_EXPERT_GROUP=cvi-expert

# ----------------------------------------------------------
# Backend API
# ----------------------------------------------------------

# URL internal backend (digunakan oleh server-side Next.js, dalam Docker)
BACKEND_API_INTERNAL_URL=http://backend:8000

# URL publik backend (digunakan oleh client-side browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ----------------------------------------------------------
# Aplikasi
# ----------------------------------------------------------

# Nama aplikasi yang ditampilkan di UI
NEXT_PUBLIC_APP_NAME=CVI App

# ----------------------------------------------------------
# E2E Testing (hanya digunakan oleh docker-compose.e2e.yml)
# ----------------------------------------------------------

# Password untuk user test admin di Authentik
TEST_ADMIN_PASSWORD=AdminTest123!

# Password untuk user test expert di Authentik
TEST_EXPERT_PASSWORD=ExpertTest123!

# Secret key untuk Authentik (E2E environment)
AUTHENTIK_SECRET_KEY=changeme-use-real-secret-in-production

# Password bootstrap admin Authentik (hanya untuk setup awal)
AUTHENTIK_BOOTSTRAP_PASSWORD=AdminTest123!
